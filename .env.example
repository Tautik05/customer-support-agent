# Database Connection (Neon Postgres or SQLite fallback)
# Neon URL format: postgresql+asyncpg://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Synchronous format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./support_system.db
SYNC_DATABASE_URL=sqlite:///./support_system.db

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_MODEL=openai/gpt-oss-120b
FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.6-27b,groq/compound

# Application Settings
PORT=8000
ENVIRONMENT=development
